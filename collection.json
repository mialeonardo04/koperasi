    {
      "name": "🏦 Pinjaman",
      "item": [
        {
          "name": "Ajukan Pinjaman",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.id) {",
                  "    pm.collectionVariables.set('pinjaman_id', json.data.id.toString());",
                  "    pm.test('Pinjaman berhasil diajukan - ID tersimpan', function() {",
                  "        pm.expect(json.success).to.be.true;",
                  "    });",
                  "    console.log('Pinjaman ID tersimpan:', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jumlahPinjaman\": 5000000,\n  \"tenorBulan\": 12,\n  \"tujuanPinjaman\": \"Modal usaha warung makan\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pinjaman/ajukan",
              "host": ["{{base_url}}"],
              "path": ["pinjaman", "ajukan"]
            },
            "description": "Ajukan pinjaman baru. Minimal Rp 500.000, tenor 1-60 bulan. ID pinjaman otomatis tersimpan ke variable `pinjaman_id`."
          }
        },
        {
          "name": "Detail Pinjaman",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pinjaman/{{pinjaman_id}}",
              "host": ["{{base_url}}"],
              "path": ["pinjaman", "{{pinjaman_id}}"]
            },
            "description": "Lihat detail pinjaman berdasarkan ID. Member hanya bisa lihat miliknya sendiri."
          }
        },
        {
          "name": "Jadwal Angsuran",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.length > 0) {",
                  "    var angsuranBelumBayar = json.data.find(a => a.status === 'BELUM_BAYAR');",
                  "    if (angsuranBelumBayar) {",
                  "        pm.collectionVariables.set('angsuran_id', angsuranBelumBayar.id.toString());",
                  "        console.log('Angsuran ID pertama (BELUM_BAYAR) tersimpan:', angsuranBelumBayar.id);",
                  "    }",
                  "    pm.test('Jadwal angsuran berhasil diambil', function() {",
                  "        pm.expect(json.success).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pinjaman/{{pinjaman_id}}/jadwal-angsuran",
              "host": ["{{base_url}}"],
              "path": ["pinjaman", "{{pinjaman_id}}", "jadwal-angsuran"]
            },
            "description": "Lihat jadwal cicilan pinjaman. ID angsuran BELUM_BAYAR pertama otomatis tersimpan ke variable `angsuran_id`."
          }
        },
        {
          "name": "Bayar Angsuran",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"angsuranId\": {{angsuran_id}},\n  \"keterangan\": \"Pembayaran angsuran bulan ini\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/pinjaman/{{pinjaman_id}}/bayar-angsuran",
              "host": ["{{base_url}}"],
              "path": ["pinjaman", "{{pinjaman_id}}", "bayar-angsuran"]
            },
            "description": "Bayar cicilan. Gunakan `angsuran_id` dari response jadwal angsuran. Jika semua lunas, status pinjaman otomatis LUNAS."
          }
        },
        {
          "name": "Riwayat Pinjaman",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/pinjaman/riwayat?page=0&size=10",
              "host": ["{{base_url}}"],
              "path": ["pinjaman", "riwayat"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            },
            "description": "Riwayat semua pinjaman milik user yang login."
          }
        }
      ]
    },
