{
  "info": {
    "name": "Koperasi Simpan Pinjam API",
    "_postman_id": "koperasi-simpan-pinjam-2025",
    "description": "Koleksi API lengkap untuk Sistem Koperasi Simpan Pinjam\n\n## Cara Pakai\n1. Import collection ini ke Postman\n2. Set variable `base_url` = `http://localhost:8080/api`\n3. Jalankan **Auth > Login (Admin)** atau **Auth > Login (Member)**\n4. Token otomatis tersimpan ke variable `token`\n5. Semua endpoint lain langsung bisa dipakai\n\n## Akun Default\n- Admin: `admin@koperasi.id` / `admin123`\n- Member: `member@koperasi.id` / `member123`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "member_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "pinjaman_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "angsuran_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "2",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('token', json.data.accessToken);",
                  "    pm.test('Login berhasil - token tersimpan', function() {",
                  "        pm.expect(json.success).to.be.true;",
                  "    });",
                  "    console.log('Token Admin tersimpan:', json.data.accessToken.substring(0, 30) + '...');",
                  "} else {",
                  "    pm.test('Login gagal', function() {",
                  "        pm.expect(json.success).to.be.true;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@koperasi.id\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai ADMIN. Token otomatis tersimpan ke variable `token`."
          }
        },
        {
          "name": "Login Member",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.success && json.data && json.data.accessToken) {",
                  "    pm.collectionVariables.set('member_token', json.data.accessToken);",
                  "    pm.collectionVariables.set('token', json.data.accessToken);",
                  "    pm.test('Login member berhasil - token tersimpan', function() {",
                  "        pm.expect(json.success).to.be.true;",
                  "    });",
                  "    console.log('Token Member tersimpan:', json.data.accessToken.substring(0, 30) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member@koperasi.id\",\n  \"password\": \"member123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login sebagai MEMBER. Token otomatis tersimpan ke variable `token` dan `member_token`."
          }
        },
        {
          "name": "Register Member Baru",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"namaLengkap\": \"Andi Wijaya\",\n  \"email\": \"andi@email.com\",\n  \"password\": \"rahasia123\",\n  \"noTelepon\": \"08123456789\",\n  \"alamat\": \"Jl. Gatot Subroto No. 5, Jakarta\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            },
            "description": "Daftarkan member baru. Tidak butuh token. Email harus unik."
          }
        },
        {
          "name": "Get Profil Saya",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "profile"]
            },
            "description": "Ambil data profil user yang sedang login."
          }
        },
        {
          "name": "Ganti Password",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passwordLama\": \"member123\",\n  \"passwordBaru\": \"newpassword456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/change-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Ganti password user yang sedang login."
          }
        }
      ]
    },
    {
